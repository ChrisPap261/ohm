# Supabase — leave empty to use localStorage demo mode
NEXT_PUBLIC_SUPABASE_URL=

# Prefer publishable key (sb_publishable_...); legacy anon JWT also works
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias (same value as ANON_KEY if you use the new key name)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — optional for admin scripts; never expose to the client or NEXT_PUBLIC_*
# Prefer sb_secret_...; legacy service_role JWT also works
SUPABASE_SERVICE_ROLE_KEY=
